# Copy to .env.local for local work. On Vercel set these in Project → Settings → Environment Variables.

# Neon Postgres connection string (Vercel fills this automatically when you connect Neon from the Storage tab).
# Leave empty locally to use the built-in local database in ./.pglite
DATABASE_URL=

# 32+ random characters. Signs the login cookie and sign-in codes.
SESSION_SECRET=

# The no-reply Gmail account that sends every email, and its 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords). Never your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Master account (receives Master approvals; Reply-To on outgoing emails)
MASTER_EMAIL=sanjeev71@gmail.com

# Public address of the app, used in email links (optional on Vercel — it uses the production domain)
APP_URL=
